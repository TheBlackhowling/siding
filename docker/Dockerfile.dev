# Dev/test image — run siding without a local Go install.
# Source is bind-mounted at /src; machine state at /data (SIDING_DATA).
#
# Targets:
#   dev    — go test / go run (default)
#   doctor — same + Docker CLI for `siding doctor` (socket mounted at runtime)

FROM golang:1.25-bookworm AS base

WORKDIR /src

ENV CGO_ENABLED=1
ENV GOPATH=/go
ENV PATH="/go/bin:${PATH}"
ENV SIDING_DATA=/data

COPY go.mod go.sum* ./
RUN go mod download

COPY . .

CMD ["go", "test", "./..."]

FROM base AS dev

FROM base AS doctor

RUN apt-get update \
	&& apt-get install -y --no-install-recommends docker.io curl ca-certificates \
	&& mkdir -p /usr/local/lib/docker/cli-plugins \
	&& curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
		-o /usr/local/lib/docker/cli-plugins/docker-compose \
	&& chmod +x /usr/local/lib/docker/cli-plugins/docker-compose \
	&& rm -rf /var/lib/apt/lists/*
